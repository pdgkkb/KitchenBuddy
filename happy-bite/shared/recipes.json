          "heat": "Oven 200 °C",
          "minutes": 1,
          "uses": [
            "goat"
          ]
        },
        {
          "do": "Bake until golden.",
          "why": "Give the dish a nudge. If the middle still wobbles, it needs longer.",
          "heat": "Oven 200 °C",
