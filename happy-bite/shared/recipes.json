        {
          "id": "chilli",
          "qty": 1
        }
      ],
      "steps": [
        {
          "do": "Put a big pan of water on and salt it hard. Start this first.",
          "why": "It should taste like a light broth. This is the only chance to season the pasta itself.",
          "heat": "High",
          "minutes": 8,
          "uses": [
            "salt"
          ]
        },
        {
          "do": "While it heats, warm the oil with the garlic in a second pan.",
          "heat": "Low",
          "cue": "Garlic smells sweet, not brown",
          "minutes": 2,
          "uses": [
            "oliveoil",
            "garlic"
          ]
        },
        {
          "do": "Add the tomatoes, oregano and chilli. Let them collapse.",
          "heat": "Medium",
          "cue": "Darkened and thick, not watery",
          "minutes": 12,
          "uses": [
            "tomato",
            "oregano",
            "chilli"
          ]
        },
        {
          "do": "Cook the pasta. Keep a mug of the water before you drain.",
          "heat": "High",
          "minutes": 9,
          "uses": [
            "pasta"
          ]
        },
        {
          "do": "Tip the pasta into the sauce with a splash of that water. Toss hard.",
          "why": "The starch in the water is what makes sauce cling. Without it, it slides off.",
          "heat": "Medium",
          "cue": "Sauce coats every piece",
          "minutes": 2
        },
        {
          "do": "Off the heat, stir half the parmesan through and scatter the rest over.",
          "why": "Off the heat, or it splits into strings instead of melting in.",
          "minutes": 1,
          "uses": [
            "parmesan"
          ]
        }
      ]
