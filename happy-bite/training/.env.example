# Copy to .env (or export). HF_TOKEN is needed because RecipeNLG is gated:
# accept its terms on the dataset page first, or the download will 401.
HF_TOKEN=

# NVIDIA: Qwen/Qwen2.5-7B-Instruct
# M4 16 GB: leave blank to use Qwen/Qwen2.5-1.5B-Instruct
BASE_MODEL=
DATASET=Kaiser1308/CookingRecipes

# Put RecipeNLG's full_dataset.csv in this directory, or set an absolute path.
# When present next to build_dataset.py, it is selected automatically.
RECIPE_CSV=

MAX_RECIPES=0
