# Copy to .env and fill in. Nothing here ever reaches the browser:
# this server is the proxy that holds the keys.

# --- Chat, recipes, link import -------------------------------------
# anthropic | openai | none
#   openai also covers anything OpenAI-compatible, including a model
#   running on this machine with Ollama (set OPENAI_BASE_URL below).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- OpenAI (images, voice, or an OpenAI-compatible chat model) ------
OPENAI_API_KEY=
# Ollama on this machine, fully offline:  http://localhost:11434/v1
# (then LLM_PROVIDER=openai, LLM_MODEL=llama3.1, OPENAI_API_KEY=ollama)
OPENAI_BASE_URL=

# Using a local Qwen (base, or your fine-tune from ../training):
#   Ollama:  ollama pull qwen2.5:7b-instruct   then
#            LLM_PROVIDER=openai  LLM_MODEL=qwen2.5:7b-instruct
#            OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama
#   vLLM:    vllm serve <model> --served-model-name happybite   then
#            LLM_PROVIDER=openai  LLM_MODEL=happybite
#            OPENAI_BASE_URL=http://<host>:8000/v1  OPENAI_API_KEY=none

# --- Pictures ---------------------------------------------------------
# openai | none
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1

# --- Voice ------------------------------------------------------------
# openai | none   (none = the browser's own voice, which needs no key)
SPEECH_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
STT_MODEL=gpt-4o-mini-transcribe

# --- Server -----------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173
MEDIA_DIR=media
