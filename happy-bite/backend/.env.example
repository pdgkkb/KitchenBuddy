# LLM Configuration (e.g., LM Studio, Ollama, OpenAI)
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-e4b
LLM_CONTEXT=8192
LLM_THINK=false

# Pictures (off by default to preserve VRAM while cooking)
IMAGE_PROVIDER=none

# Voice Configuration
SPEECH_PROVIDER=local
SPEECH_BACKEND=torch
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
STT_LANGUAGE=en

# TTS Engine: 'say' (uses native OS voice: Windows System.Speech or macOS say - recommended for zero security blocks)
# or 'kokoro' / 'piper'
TTS_ENGINE=say
