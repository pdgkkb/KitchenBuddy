# --- Append these to backend/.env for local Qwen + local voice ---

# Local Qwen through Ollama (no token limits)
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
OPENAI_API_KEY=ollama

# Fully-local voice
SPEECH_PROVIDER=local
WHISPER_MODEL=base
WHISPER_DEVICE=auto
STT_LANGUAGE=
PIPER_VOICE=/path/to/fr_FR-siwis-medium.onnx
WAKE_WORD=hey chef
